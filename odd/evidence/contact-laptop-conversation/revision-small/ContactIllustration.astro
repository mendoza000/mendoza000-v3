---
import type { Locale } from '@/content/portfolio';
import fallbackSvg from '../../../../public/hairline/contact-conversation-rest.svg?raw';
const { locale } = Astro.props as { locale: Locale };
---
<div class="contact-illustration" data-contact-conversation>
  <div class="conversation-stage" data-conversation-stage role="img" aria-label={locale === 'es' ? 'Pantalla frontal con un mensaje recibido y una respuesta verde' : 'Frontal screen with an incoming message and a green reply'}>
    <div class="conversation-fallback" aria-hidden="true" set:html={fallbackSvg}></div>
    <svg viewBox="0 0 400 320" aria-hidden="true"></svg>
    <span class="sr-only" data-conversation-read aria-live="off" aria-atomic="true">{locale === 'es' ? 'en reposo' : 'rest'}</span>
  </div>
</div>
<style>
.contact-illustration{width:min(100%,27.5rem);margin-top:clamp(1.5rem,3vw,2.5rem)}
.conversation-stage{position:relative;width:min(100%,25rem);aspect-ratio:5/4;touch-action:pan-y}
.conversation-stage>svg,.conversation-fallback{position:absolute;inset:0;display:block;width:100%;height:100%}
.conversation-fallback :global(svg){display:block;width:100%;height:100%}
.contact-illustration[data-mounted="true"] .conversation-fallback{visibility:hidden}
.conversation-stage :global(path){fill:var(--portfolio-surface);stroke:#52525b;stroke-width:1.2;stroke-linejoin:round;stroke-linecap:round;vector-effect:non-scaling-stroke}
.conversation-stage :global(circle){fill:#52525b;stroke:none}.conversation-stage :global(.dot.off){opacity:.16}.conversation-stage :global(.dot.m){fill:#52525b}.conversation-stage :global(.nf){fill:none}.conversation-stage :global(.lo){stroke:color-mix(in srgb,#52525b 45%,transparent)}.conversation-stage :global(.hi){stroke:#15803d}
:global(html.dark) .conversation-stage :global(path){fill:var(--portfolio-surface);stroke:#d4d4d8}:global(html.dark) .conversation-stage :global(circle){fill:#d4d4d8}:global(html.dark) .conversation-stage :global(.dot.m){fill:#d4d4d8}:global(html.dark) .conversation-stage :global(.lo){stroke:color-mix(in srgb,#d4d4d8 45%,transparent)}:global(html.dark) .conversation-stage :global(.hi){stroke:#4ade80}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
</style>
<script>import './contact-illustration.mjs';</script>
