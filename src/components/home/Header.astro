---
import PortfolioIcon from "@/components/ui/PortfolioIcon";
import { portfolio, type Locale } from "@/content/portfolio";
const { locale } = Astro.props as { locale: Locale };
const copy = portfolio[locale];
const cv = "https://docs.google.com/document/d/1FZJGxmnlFurOBx3n6XwUYd3EJ1CoIkNi/edit?usp=sharing&ouid=101889099240565360165&rtpof=true&sd=true";
---
<header id="top" class="portfolio-hero">
  <div class="portfolio-wrap portfolio-hero-content">
    <h1>{copy.greeting} <span>{"Omar Mendoza."}</span></h1>
    <p class="portfolio-hero-offer">{copy.role}</p>
    <p class="portfolio-hero-detail">{copy.specialty}{copy.outcome}</p>
    <nav aria-label={locale === "es" ? "Accesos principales" : "Primary actions"} class="portfolio-actions">
      <a class="portfolio-action portfolio-action-primary" href="#contact"><PortfolioIcon name="contact" className="h-6 w-6" />{copy.clientCta}</a>
      <a class="portfolio-action portfolio-action-secondary" href={cv} target="_blank" rel="noopener noreferrer"><PortfolioIcon name="file-text" className="h-6 w-6" />{copy.recruiterCta}</a>
    </nav>
  </div>
</header>
