---
import PortfolioIcon from "@/components/ui/PortfolioIcon";
import ContactsBar from "./ContactsBar.astro";
import ContactIllustration from "./ContactIllustration.astro";
import { portfolio, type Locale } from "@/content/portfolio";
const { locale } = Astro.props as { locale: Locale };
const copy = portfolio[locale];
---
<section class="portfolio-section portfolio-wrap portfolio-contact" id="contact">
  <div class="portfolio-contact-intro"><h2 class="portfolio-heading"><PortfolioIcon name="contact" className="portfolio-heading-icon" /><span>{copy.contactHeading}</span></h2><p class="portfolio-section-intro">{copy.contactCopy}</p><ContactIllustration locale={locale} /></div>
  <ContactsBar locale={locale} />
</section>
