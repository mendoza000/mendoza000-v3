---
import type { Locale } from '@/content/portfolio';
import fallbackSvg from '../../../../public/hairline/contact-envelope-rest.svg?raw';
const { locale } = Astro.props as { locale: Locale };
---
<div class="contact-envelope" data-contact-envelope>
  <div class="envelope-stage" data-envelope-stage role="img" aria-label={locale === 'es' ? 'Sobre isométrico que abre la solapa al acercarte' : 'Isometric envelope that opens its flap as you approach'}>
    <div class="envelope-fallback" aria-hidden="true" set:html={fallbackSvg}></div>
    <svg viewBox="0 0 400 320" aria-hidden="true"></svg>
    <span class="sr-only" data-envelope-read>rest</span>
  </div>
</div>
<style>
  .contact-envelope { width: min(100%, 27.5rem); margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  .envelope-stage { position: relative; width: min(100%, 25rem); aspect-ratio: 5 / 4; touch-action: pan-y; }
  .envelope-stage > svg, .envelope-fallback { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .envelope-fallback :global(svg) { display: block; width: 100%; height: 100%; }
  .contact-envelope[data-mounted="true"] .envelope-fallback { visibility: hidden; }
  .envelope-stage :global(path) { fill: var(--portfolio-surface); stroke: #15803d; stroke-width: 1.2; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .envelope-stage :global(.nf) { fill: none; }
  .envelope-stage :global(.lo) { stroke: color-mix(in srgb, #15803d 34%, transparent); }
  .envelope-stage :global(.hi) { stroke: #4ade80; }
  :global(html.dark) .envelope-stage :global(path) { fill: var(--portfolio-surface); stroke: #4ade80; }
  :global(html.dark) .envelope-stage :global(.lo) { stroke: color-mix(in srgb, #4ade80 32%, transparent); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
<script>
  import './contact-envelope.mjs';
</script>
