---
import PortfolioIcon from "@/components/ui/PortfolioIcon";
import ContactItem from "./contact-item.astro";
import type { Locale } from "@/content/portfolio";
const { locale } = Astro.props as { locale: Locale };
---

<div class="portfolio-contact-list">
	<div class="portfolio-contact-primary">
		<ContactItem href="mailto:mendoza000.dev@gmail.com" title="mendoza000.dev@gmail.com" text={locale === "es" ? "Escríbeme sobre tu proyecto" : "Email me about your project"}>
			<PortfolioIcon name="email" className="h-12 w-12 text-green-500" />
		</ContactItem>
		<ContactItem href="https://docs.google.com/document/d/1FZJGxmnlFurOBx3n6XwUYd3EJ1CoIkNi/edit?usp=sharing&ouid=101889099240565360165&rtpof=true&sd=true" title={locale === "es" ? "Ver CV" : "View CV"} text={locale === "es" ? "Experiencia y formación" : "Experience and education"}>
			<PortfolioIcon name="file-text" className="h-6 w-6 text-green-700 dark:text-green-400" />
		</ContactItem>
	</div>
	<div class="portfolio-contact-socials" aria-label={locale === "es" ? "Redes sociales" : "Social links"}>
	<ContactItem
		href="https://x.com/mendoza000x"
		title="Twitter | @mendoza000x"
		text={locale === "es" ? "Sígueme en Twitter/X" : "Follow me on Twitter/X"}
	>
		<PortfolioIcon name="twitter" className="h-12 w-12 text-green-500" />
	</ContactItem>

	<ContactItem
		href="https://github.com/mendoza000"
		title="Github | @mendoza000"
		text={locale === "es" ? "Mira mis proyectos y contribuciones" : "View my projects and contributions"}
	>
		<PortfolioIcon name="github" className="h-12 w-12 text-green-500" />
	</ContactItem>

	<ContactItem
		href="https://discordapp.com/users/mendoza000#2939"
		title="Discord | @mendoza000"
		text={locale === "es" ? "Juguemos o conversemos por Discord" : "Let's play or chat on Discord"}
	>
		<PortfolioIcon name="discord" className="h-12 w-12 text-green-500" />
	</ContactItem>

	</div>
</div>
