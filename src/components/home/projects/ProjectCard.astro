---
import { Image } from "astro:assets";
import PortfolioIcon from "@/components/ui/PortfolioIcon";
import { portfolio, type Locale } from "@/content/portfolio";

interface Props {
	img: any;
	title: string;
	description: string;
	link: string;
	github?: string;
	tags: string[];
	alt: string;
	locale: Locale;
}

const props: Props = Astro.props;
const copy = portfolio[props.locale];
---

<div
	class="portfolio-project"
>
	<div class="portfolio-project-heading">
		<h4 class="font-bold capitalize text-xl">{props.title}</h4>

		<div class="flex gap-1">
			{
				props.github && (
					<a
						class="p-1 rounded-lg border-2 border-transparent inline-flex duration-200 group hover:border-zinc-700"
						href={props.github}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`${copy.projectRepository} ${props.title} ${copy.projectRepositorySuffix}`}
					>
						<PortfolioIcon name="github" className="group-hover:animate-wiggle-more group-hover:animate-twice group-hover:animate-duration-700 h-5 w-5 text-zinc-500" />
					</a>
				)
			}

			<a
				class="p-1 rounded-lg border-2 border-transparent inline-flex duration-200 group hover:border-zinc-700"
				href={props.link}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`${copy.projectOpen}: ${props.title}`}
			>
				<PortfolioIcon name="arrow-up-right" className="group-hover:animate-wiggle-more group-hover:animate-twice group-hover:animate-duration-700 h-5 w-5 text-zinc-500" />
			</a>
		</div>
	</div>
	<div class="portfolio-project-image aspect-[4/3] overflow-hidden">
			<Image
				src={props.img}
				alt={props.alt}
				class={"h-full w-full object-cover"}
				draggable="false"
			/>
	</div>
	<p class="portfolio-project-description">{props.description}</p>
	<div class="portfolio-tech-list" aria-label={props.locale === "es" ? "Tecnologías" : "Technologies"}>
		{props.tags.map((tag) => <span>{tag}</span>)}
	</div>

</div>
