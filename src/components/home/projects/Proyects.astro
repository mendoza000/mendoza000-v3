---
import PortfolioIcon from "@/components/ui/PortfolioIcon";
import ProjectsList from "./ProjectsList.astro";
import { portfolio, type Locale } from "@/content/portfolio";
const { locale } = Astro.props as { locale: Locale };
const copy = portfolio[locale];
---

<section
	class="portfolio-section portfolio-wrap"
	id="projects"
>
	<div>
		<h2 class="portfolio-heading">
			<PortfolioIcon name="folder" className="portfolio-heading-icon" />
			<span>{copy.projectsHeading}</span>
		</h2>
		<p class="portfolio-section-intro">{copy.projectsIntro}</p>
	</div>

	<ProjectsList locale={locale} />
</section>
