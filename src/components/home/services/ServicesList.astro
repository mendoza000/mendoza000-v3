---
import ServiceIllustration from "./ServiceIllustration.astro";
import { portfolio, type Locale } from "@/content/portfolio";
const { locale } = Astro.props as { locale: Locale };
const copy = portfolio[locale];
const figures = ["exploded", "patch", "slow", "gateway", "terminal", "maintenance"] as const;
const fallbacks = ["/hairline/web-app-rest.svg", "/hairline/integrations-rest.svg", "/hairline/automation-rest.svg", "/hairline/bookings-payments-rest.svg", "/hairline/dashboard-rest.svg", "/hairline/maintenance-rest.svg"];
---
<div class="services-grid">
  {copy.serviceTitles.map((title, index) => <ServiceIllustration
    figure={figures[index]}
    title={title}
    description={copy.serviceDescriptions[index]}
    label={copy.serviceIllustrationLabels[index]}
    fallbackAsset={fallbacks[index]}
    contactCta={copy.serviceContactCta}
    evidence={copy.serviceEvidence[index]}
  />)}
</div>
<style>
  .services-grid { display:grid; grid-template-columns:minmax(0,1fr); align-items:stretch; gap:1.25rem; }
  @media (min-width:768px) { .services-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.5rem; } }
  @media (min-width:1100px) { .services-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
</style>
