---
import { portfolio, type Locale } from "@/content/portfolio";
const { locale } = Astro.props as { locale: Locale };
const currentYear = new Date().getFullYear();
---
<footer class="portfolio-footer"><p>{locale === "es" ? "Hecho por" : "Made by"} <span>Omar Mendoza</span></p><p><span>©</span> {currentYear} {portfolio[locale].footer}</p></footer>
