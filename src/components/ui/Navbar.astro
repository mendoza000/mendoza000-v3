---
import { portfolio, type Locale } from "@/content/portfolio";
const { locale } = Astro.props as { locale: Locale };
const copy = portfolio[locale];
const nav = locale === "es" ? ["Inicio", "Servicios", "Proyectos", "Experiencia", "Contacto"] : ["Home", "Services", "Projects", "Experience", "Contact"];
---
<nav aria-label={locale === "es" ? "Navegación principal" : "Main navigation"} class="portfolio-nav sticky flex-wrap">
  <div class="portfolio-wrap portfolio-nav-inner">
    <a href={locale === "es" ? "/es/" : "/en/"} class="portfolio-wordmark" aria-label={copy.nav[0]}>MENDOZA000</a>
    <ul id="portfolio-nav-links" class="portfolio-nav-links">
      <li><a href="#top">{nav[0]}</a></li>
      <li><a href="#services">{nav[1]}</a></li>
      <li><a href="#projects">{nav[2]}</a></li>
      <li><a href="#experiences">{nav[3]}</a></li>
      <li><a href="#contact">{nav[4]}</a></li>
    </ul>
    <div class="portfolio-nav-controls">
      <a lang={locale === "es" ? "en" : "es"} hreflang={locale === "es" ? "en" : "es"} class="portfolio-language-toggle" href={locale === "es" ? "/en/" : "/es/"}>{locale === "es" ? "EN" : "ES"}</a>
      <button type="button" lang={locale} class="portfolio-theme-toggle" data-theme-toggle data-theme-label-light={locale === "es" ? "Cambiar al tema claro" : "Switch to light theme"} data-theme-label-dark={locale === "es" ? "Cambiar al tema oscuro" : "Switch to dark theme"} aria-label={locale === "es" ? "Cambiar tema" : "Toggle color theme"} aria-pressed="false"><svg data-theme-icon="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg><svg data-theme-icon="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/></svg></button>
      <button type="button" lang={locale} class="portfolio-menu-toggle" aria-label={locale === "es" ? "Abrir menú" : "Open menu"} aria-expanded="false" aria-controls="portfolio-nav-links" data-menu-toggle><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
    </div>
  </div>
</nav>
<script>
  const syncThemeButton = (button: HTMLButtonElement) => {
    const dark = document.documentElement.classList.contains("dark");
    button.setAttribute("aria-pressed", String(dark));
    button.setAttribute("aria-label", dark ? button.dataset.themeLabelLight! : button.dataset.themeLabelDark!);
    button.dataset.activeTheme = dark ? "dark" : "light";
  };
  const initializeThemeButtons = () => {
    const menuButton = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = document.querySelector<HTMLUListElement>("#portfolio-nav-links");
    if (menuButton && menu && menuButton.dataset.initialized !== "true") {
      menuButton.dataset.initialized = "true";
      const closeMenu = () => {
        menuButton.setAttribute("aria-expanded", "false");
        menuButton.setAttribute("aria-label", menuButton.lang === "en" ? "Open menu" : "Abrir menú");
      };
      menuButton.onclick = () => {
        const expanded = menuButton.getAttribute("aria-expanded") !== "true";
        menuButton.setAttribute("aria-expanded", String(expanded));
        menuButton.setAttribute("aria-label", expanded ? (menuButton.lang === "en" ? "Close menu" : "Cerrar menú") : (menuButton.lang === "en" ? "Open menu" : "Abrir menú"));
      };
      menu.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) closeMenu();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMenu();
      });
    }
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
      syncThemeButton(button);
      button.onclick = () => {
        const dark = !document.documentElement.classList.contains("dark");
        document.documentElement.classList.toggle("dark", dark);
        try { window.localStorage.setItem("theme", dark ? "dark" : "light"); } catch { /* Theme still works when storage is unavailable. */ }
        syncThemeButton(button);
      };
    });
  };
  document.addEventListener("astro:page-load", initializeThemeButtons);
  initializeThemeButtons();
</script>
